---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

// This pulls your subfolder name ('/my-portfolio') directly from your config automatically
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hello there 👋</div>
    <div class="text-5xl font-bold">I'm Adham Dweck</div>
    <div class="text-3xl py-3 font-bold">Computer Science Student and Aspiring Software Engineer;</div>
    <div class="py-2">
      <text class="text-lg">
        Hello, My name is Adham Dweck, I am an Engineering student. 
        With 1 year of coding experience, they have helped me achieve my goal of reaching people who are likeminded. 
        When I am not working I am watching soccer or playing games.
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://twitter.com/manuelernestog" target="_blank"> Let's connect!</a>
      <a href="https://github.com/manuelernestog/astrofy" target="_blank" class="btn btn-outline ml-5">
        Get This template
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="BlackBox"
    img={`${baseUrl}/AdhamD_Handsome_workingOnTheBlackBox.JPG`}
    desc="Blackbox investigation find out whats inside but you cant open the box."
    url="#"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Mobile App Work in Progress"
    img={`${baseUrl}/post_img.webp`}
    desc="N/A"
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Screenprint"
    img={`${baseUrl}/Adham_Hands.JPG`}
    desc="Create a meaningful message learn different Photoshop tools to do so."
    url="#"
    badge="FOSS"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage ? `${baseUrl}${post.data.heroImage}` : undefined}
          desc={post.data.description}
          url={`${baseUrl}/blog/` + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>