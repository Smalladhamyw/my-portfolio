---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
   Hello, My name is Adham Dweck, I am an Engineering student. 
   With 1 year of coding experience, they have helped me achieve my goal of reaching people who are likeminded. 
   When I am not working I am watching soccer or playing games.

  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="High School"
      subtitle="[2024] to [2028] at [ESUMS], [New Haven], [Connecticut]"
    />
    <TimeLineElement
      title="Title Name"
      subtitle="[start year] to [end year] at [Study Center Name], [City], [Country]"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="New Haven Reads Voluenteer"
      subtitle="From [2025] to [Present] at [New Haven Reads], [New Haven], [Connecticut]"
    >
      Volunteering at a non-profit whose goal is to educate the youth in the English language. 
      Giving back to the community that I was once a part of.


    </TimeLineElement>
    <TimeLineElement
      title="Captain Of Robodominators"
      subtitle="From [2025] to [Present] at [FIRST Robotics], [New Haven], [Connecticut]"
    >
      Building and testing a robot to compete in competitions. Leading my peers and myself to be the best version I can be on and off the field.
    </TimeLineElement>
    <TimeLineElement
      title="Co-Founder/Co-President"
      subtitle="From [2025] to [Present] at [ESUMS Aerospace Club], [New Haven], [Connecticut]"
    >
      As Vice-President, I lead the class to increase the funds of the class through student-led fundraisers.
      Planned and hosted events for the class of 28’ and whole school as President.
      Through polling, class satisfaction has increased by 40% overall

    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      <a href="#" target="_blank"> Certification Name (with link)</a>
    </li>
    <li>
      <a href="#" target="_blank"> Certification Name (with link)</a>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Phython(Beginner)</li>
    <li>CAD (Intermediate)</li>
    <li>Exel(Intermediate)</li>
    <li>Lab Work(Beginner)</li>
    <li>Arabic(Native Speaker)</li>
    <li>English(Advanced) </li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
    <li>Skill Name</li>
  </ul>
</BaseLayout>
